# ---- 环境 ----
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.env

# ---- 原始与中间数据（体积大，不入库）----
data/raw/**
data/interim/**
!data/raw/.gitkeep
!data/interim/.gitkeep

# ---- 大体积产物 ----
*.pkl
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.parquet
*.zip
*.7z
large_files/

# ---- 规范：outputs 中的小文件要入库，大文件不入库 ----
outputs/**/*.tmp

# ---- 嵌套仓库（scripts/tools 下拉取的上游工具）----
scripts/tools/*/.git/

# ---- 论文生成过程的临时/中间产物 ----
# MathType 转换中间件（mathml / preview / ole）
paper/_mathtype_work/
# MathType 链路冒烟测试产物
paper/_mathtype_smoke/
# PDF 页面预览图（人工检查排版留白）
paper/_preview/
# 诊断用副本
paper/_probe_min/
paper/_probe*.docx
paper/*_probe.pdf
# Word 打开文档时留下的锁文件
paper/~$*

# ---- 编辑器/系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
# pandoc 中间产物（LaTeX → Word 转换的临时目录）
otheragent/_pandoc/
# PDF→Word 转换的切片中间产物
paper/_reflow_chunks/
outputs/diag/reflow/
outputs/diag/_probe_small.pdf
