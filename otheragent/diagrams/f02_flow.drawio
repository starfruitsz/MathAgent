        <mxCell id="n10" value="局部搜索：搬箱 / 合并架次&lt;br&gt;字典序目标（及时性 → 架次数 → 能耗）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="644" width="420" height="64" as="geometry"/></mxCell>
