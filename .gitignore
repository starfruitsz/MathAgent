# ---- 环境 ----
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.env

# ---- 原始与中间数据（体积大，不入库）----
data/raw/**
data/interim/**
!data/raw/.gitkeep
!data/interim/.gitkeep

# ---- 大体积产物 ----
*.pkl
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.parquet
*.zip
*.7z
large_files/

# ---- 规范：outputs 中的小文件要入库，大文件不入库 ----
outputs/**/*.tmp

# ---- 嵌套仓库（scripts/tools 下拉取的上游工具）----
scripts/tools/*/.git/

# ---- 论文生成过程的临时/中间产物 ----
# MathType 转换中间件（mathml / preview / ole）
paper/_mathtype_work/
# MathType 链路冒烟测试产物
paper/_mathtype_smoke/
# PDF 页面预览图（人工检查排版留白）
paper/_preview/
# 诊断用副本
paper/_probe_min/
paper/_probe*.docx
paper/*_probe.pdf
# Word 打开文档时留下的锁文件
paper/~$*

# ---- 编辑器/系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
# pandoc 中间产物（LaTeX → Word 转换的临时目录）
otheragent/_pandoc/
# PDF→Word 转换的切片中间产物
paper/_reflow_chunks/
outputs/diag/reflow/
outputs/diag/_probe_small.pdf

# 论文产物：仅保留 PDF→Word(pdf2docx) 一份入库，其余（Python 管线论文与
# LaTeX 公式版、Word 重排版）不入库 —— 它们可由管线随时重新生成：
#   python -m src.report.build_paper         # 生成 _论文.docx
#   python scripts/check_paper.py --pdf      # 导出 _论文.pdf
#   pwsh -File scripts/build_word_from_latex.ps1                 # LaTeX 公式版
#   python scripts/diag/pdf_to_docx_chunked.py                   # Word 重排版
paper/山区洪涝灾害下无人机运输与通信协同优化_论文.docx
paper/山区洪涝灾害下无人机运输与通信协同优化_论文.pdf
paper/山区洪涝灾害下无人机运输与通信协同优化_论文_LaTeX公式版.docx
paper/山区洪涝灾害下无人机运输与通信协同优化_论文_LaTeX公式版.pdf
paper/山区洪涝灾害下无人机运输与通信协同优化_论文_PDF转Word.docx
