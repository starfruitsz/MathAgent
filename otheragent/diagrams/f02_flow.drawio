        <mxCell id="n8" value="选序：站点 ≤ 6 全排列&lt;br&gt;&gt; 6 用最近邻 + 2-opt" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="536" width="420" height="64" as="geometry"/></mxCell>
