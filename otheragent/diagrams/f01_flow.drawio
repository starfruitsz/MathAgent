<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17" pages="1">
  <diagram id="fig" name="问题一求解流程：最大安全载荷反解与货箱组批">
    <mxGraphModel dx="1120" dy="1326" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1326" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="问题一求解流程：最大安全载荷反解与货箱组批" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8edf4;strokeColor=#3b547f;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1020" height="48" as="geometry"/></mxCell>
        <mxCell id="n1" value="输入：15 个节点坐标 + 30 m DEM&lt;br&gt;3 种机型参数 + 80 箱清单" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="104" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="n2" value="逐航段几何&lt;br&gt;H&lt;sub&gt;cruise&lt;/sub&gt; = 沿线最高地面高程 + 50 m&lt;br&gt;得 d&lt;sub&gt;ij&lt;/sub&gt;、h⁺&lt;sub&gt;ij&lt;/sub&gt;、h⁻&lt;sub&gt;ij&lt;/sub&gt;（240 条航段）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="212" width="420" height="87" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#1f3f6b;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="169" as="sourcePoint"/><mxPoint x="520" y="211" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n4" value="载荷—航程关系&lt;br&gt;L&lt;sub&gt;g&lt;/sub&gt;(q) = L&lt;sub&gt;g0&lt;/sub&gt; − (L&lt;sub&gt;g0&lt;/sub&gt;−L&lt;sub&gt;gF&lt;/sub&gt;)·(q/Q&lt;sub&gt;g&lt;/sub&gt;)&lt;sup&gt;3/2&lt;/sup&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeef4;strokeColor=#668d89;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="343" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#1f3f6b;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="300" as="sourcePoint"/><mxPoint x="520" y="342" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n6" value="能量约束取等号反解&lt;br&gt;E&lt;sub&gt;g&lt;/sub&gt;&lt;sup&gt;T&lt;/sup&gt;(q) = (1−ρ&lt;sub&gt;g&lt;/sub&gt;)·E&lt;sub&gt;g&lt;/sub&gt;&lt;sup&gt;use&lt;/sup&gt;&lt;br&gt;（单调 + Brent 法，回代误差 5.6e-15）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e5dfeb;strokeColor=#9b979f;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="451" width="420" height="87" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#1f3f6b;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="408" as="sourcePoint"/><mxPoint x="520" y="450" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n8" value="q&lt;sub&gt;max&lt;/sub&gt; = min(能量反解值, Q&lt;sub&gt;g&lt;/sub&gt;, 体积对应质量)&lt;br&gt;记录实际生效的约束类型" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="582" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#1f3f6b;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="539" as="sourcePoint"/><mxPoint x="520" y="581" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="d10" value="生效约束？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="690" width="260" height="104" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#1f3f6b;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="647" as="sourcePoint"/><mxPoint x="520" y="689" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="b12" value="结构/体积生效&lt;br&gt;⇒ q&lt;sub&gt;max&lt;/sub&gt; = Q&lt;sub&gt;g&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="680" width="270" height="64" as="geometry"/></mxCell>
        <mxCell id="e13" value="结构" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#6b7684;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="651" y="742" as="sourcePoint"/><mxPoint x="759" y="712" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n14" value="逐服务区二维装箱（FFD）&lt;br&gt;质量 Σm&lt;sub&gt;b&lt;/sub&gt; ≤ q&lt;sub&gt;max&lt;/sub&gt;，体积 Σv&lt;sub&gt;b&lt;/sub&gt; ≤ V&lt;sub&gt;g&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="838" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#1f3f6b;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="795" as="sourcePoint"/><mxPoint x="520" y="837" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#6b7684;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="895" y="745" as="sourcePoint"/><mxPoint x="520" y="837" as="targetPoint"/><Array as="points"><mxPoint x="895" y="816"/><mxPoint x="520" y="816"/></Array></mxGeometry></mxCell>
        <mxCell id="n17" value="下界校验：Martello–Toth 型解析下界&lt;br&gt;LB = max(⌈Σm/q&lt;sub&gt;max&lt;/sub&gt;⌉, ⌈Σv/V&lt;sub&gt;g&lt;/sub&gt;⌉)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeef4;strokeColor=#668d89;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="946" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#1f3f6b;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="903" as="sourcePoint"/><mxPoint x="520" y="945" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="d19" value="启发式解 = 下界？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e5dfeb;strokeColor=#9b979f;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="1054" width="260" height="104" as="geometry"/></mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#1f3f6b;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="1011" as="sourcePoint"/><mxPoint x="520" y="1053" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="b21" value="否 ⇒ 回局部搜索&lt;br&gt;继续合并/重排" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="1044" width="270" height="64" as="geometry"/></mxCell>
        <mxCell id="e22" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#6b7684;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="651" y="1106" as="sourcePoint"/><mxPoint x="759" y="1076" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n23" value="输出：18 架次（全 C 型）&lt;br&gt;总能耗 75.07 kWh｜ρ&lt;sub&gt;g&lt;/sub&gt; 敏感性曲线" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="1202" width="420" height="64" as="geometry"/></mxCell>
