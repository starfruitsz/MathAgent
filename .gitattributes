# 统一换行符处理，避免跨平台 CRLF 警告与 diff 噪声
* text=auto eol=lf

# 明确文本文件
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.ps1   text eol=crlf
*.csv   text eol=lf

# 二进制文件不做转换
*.png   binary
*.jpg   binary
*.pdf   binary
*.pkl   binary
*.xlsx  binary
*.docx  binary
*.pt    binary
