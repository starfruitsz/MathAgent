        <mxCell id="title" value="问题二求解流程：异构多点多架次运输调度" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e8edf4;strokeColor=#3b547f;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1020" height="48" as="geometry"/></mxCell>
        <mxCell id="n1" value="输入：80 箱清单 + 异构机队 A×4+B×2+C×2&lt;br&gt;14 组共享电池 + 两类时限" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="104" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="n2" value="候选机队：同构 A/B/C 与真实混合机队&lt;br&gt;三种装配策略，按真实调度评分取优" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="212" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#1f3f6b;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="169" as="sourcePoint"/><mxPoint x="520" y="211" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n4" value="构造：按「首批优先 → 期望升序 →&lt;br&gt;优先系数降序 → 体积降序」入批或新开架次" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeef4;strokeColor=#668d89;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="320" width="420" height="64" as="geometry"/></mxCell>
