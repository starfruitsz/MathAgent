        <mxCell id="n6" value="首批专架次按键队槽位轮转挑机型&lt;br&gt;（4A→2B→2C，使 8 个 60 min 档区各占一架）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e5dfeb;strokeColor=#9b979f;strokeWidth=1;fontSize=16;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="428" width="420" height="64" as="geometry"/></mxCell>
